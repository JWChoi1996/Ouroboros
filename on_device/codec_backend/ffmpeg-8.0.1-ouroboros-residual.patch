     AV_FRAME_DATA_3D_REFERENCE_DISPLAYS,
+
+    /**
+     * Internal Ouroboros instrumentation for exact H.264 effective residuals.
+     * The payload is versioned and UUID-namespaced; it is not bitstream SEI.
+     */
+    AV_FRAME_DATA_OUROBOROS_H264_RESIDUAL,
 };
 
 enum AVActiveFormatDescription {
