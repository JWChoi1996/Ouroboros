diff --git a/libavcodec/ouroboros_h264_residual.h b/libavcodec/ouroboros_h264_residual.h
new file mode 100644
index 0000000..52b71ea
--- /dev/null
+++ b/libavcodec/ouroboros_h264_residual.h
@@ -0,0 +1,183 @@
+/*
+ * Internal Ouroboros H.264 decoder instrumentation.
+ *
+ * This payload is attached as AV_FRAME_DATA_OUROBOROS_H264_RESIDUAL. It is
+ * decoder-generated side data, not H.264 SEI and not transform coefficients.
+ */
+#ifndef AVCODEC_OUROBOROS_H264_RESIDUAL_H
+#define AVCODEC_OUROBOROS_H264_RESIDUAL_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/attributes.h"
+#include "libavutil/frame.h"
+
+#define OUROBOROS_RESIDUAL_VERSION 2U
+#define OUROBOROS_RESIDUAL_COLUMNS 10U
+#define OUROBOROS_RESIDUAL_FLAG_VALIDATION (1U << 0)
+
+static const uint8_t ff_ouroboros_residual_uuid[16] = {
+    'O', 'U', 'R', 'O', 'B', 'O', 'R', 'O',
+    'S', 'H', '2', '6', '4', 'R', '2', '\0'
+};
+
+typedef struct OuroborosResidualHeader {
+    uint8_t uuid[16];
+    uint32_t version;
+    uint32_t width;
+    uint32_t height;
+    uint32_t chroma_width;
+    uint32_t chroma_height;
+    uint32_t mb_width;
+    uint32_t mb_height;
+    uint32_t flags;
+    uint32_t payload_bytes;
+} OuroborosResidualHeader;
+
+static av_always_inline size_t ff_ouroboros_y_count(
+    const OuroborosResidualHeader *header)
+{
+    return (size_t)header->width * header->height;
+}
+
+static av_always_inline size_t ff_ouroboros_c_count(
+    const OuroborosResidualHeader *header)
+{
+    return (size_t)header->chroma_width * header->chroma_height;
+}
+
+static av_always_inline size_t ff_ouroboros_summary_count(
+    const OuroborosResidualHeader *header)
+{
+    return (size_t)header->mb_width * header->mb_height *
+           OUROBOROS_RESIDUAL_COLUMNS;
+}
+
+static av_always_inline size_t ff_ouroboros_payload_size(
+    uint32_t width, uint32_t height, uint32_t flags)
+{
+    const size_t y_count = (size_t)width * height;
+    const size_t c_count = (size_t)((width + 1) / 2) * ((height + 1) / 2);
+    const size_t sample_count = y_count + 2 * c_count;
+    const size_t mb_count = (size_t)((width + 15) / 16) *
+                            ((height + 15) / 16);
+    size_t size = sizeof(OuroborosResidualHeader);
+    size += sample_count * sizeof(int16_t);
+    size += sample_count * sizeof(uint8_t);
+    if (flags & OUROBOROS_RESIDUAL_FLAG_VALIDATION)
+        size += 2 * sample_count * sizeof(uint8_t);
+    size = (size + sizeof(float) - 1) & ~(sizeof(float) - 1);
+    size += mb_count * OUROBOROS_RESIDUAL_COLUMNS * sizeof(float);
+    return size;
+}
+
+static av_always_inline AVFrameSideData *ff_ouroboros_residual_side_data(
+    AVFrame *frame)
+{
+    AVFrameSideData *side = av_frame_get_side_data(
+        frame, AV_FRAME_DATA_OUROBOROS_H264_RESIDUAL);
+    OuroborosResidualHeader *header;
+    if (!side || side->size < sizeof(*header))
+        return NULL;
+    header = (OuroborosResidualHeader *)side->data;
+    if (memcmp(header->uuid, ff_ouroboros_residual_uuid,
+               sizeof(header->uuid)) ||
+        header->version != OUROBOROS_RESIDUAL_VERSION ||
+        header->payload_bytes != side->size)
+        return NULL;
+    return side;
+}
+
+static av_always_inline int16_t *ff_ouroboros_residual_y(
+    OuroborosResidualHeader *header)
+{
+    return (int16_t *)(header + 1);
+}
+
+static av_always_inline int16_t *ff_ouroboros_residual_u(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_residual_y(header) + ff_ouroboros_y_count(header);
+}
+
+static av_always_inline int16_t *ff_ouroboros_residual_v(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_residual_u(header) + ff_ouroboros_c_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_valid_y(
+    OuroborosResidualHeader *header)
+{
+    return (uint8_t *)(ff_ouroboros_residual_v(header) +
+                       ff_ouroboros_c_count(header));
+}
+
+static av_always_inline uint8_t *ff_ouroboros_valid_u(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_valid_y(header) + ff_ouroboros_y_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_valid_v(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_valid_u(header) + ff_ouroboros_c_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_prediction_y(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_valid_v(header) + ff_ouroboros_c_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_prediction_u(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_prediction_y(header) + ff_ouroboros_y_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_prediction_v(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_prediction_u(header) + ff_ouroboros_c_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_reconstruction_y(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_prediction_v(header) + ff_ouroboros_c_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_reconstruction_u(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_reconstruction_y(header) +
+           ff_ouroboros_y_count(header);
+}
+
+static av_always_inline uint8_t *ff_ouroboros_reconstruction_v(
+    OuroborosResidualHeader *header)
+{
+    return ff_ouroboros_reconstruction_u(header) +
+           ff_ouroboros_c_count(header);
+}
+
+static av_always_inline float *ff_ouroboros_coefficient_summaries(
+    OuroborosResidualHeader *header)
+{
+    uint8_t *cursor = ff_ouroboros_valid_v(header) +
+                      ff_ouroboros_c_count(header);
+    if (header->flags & OUROBOROS_RESIDUAL_FLAG_VALIDATION)
+        cursor += 2 * (ff_ouroboros_y_count(header) +
+                       2 * ff_ouroboros_c_count(header));
+    {
+        size_t offset = (size_t)(cursor - (uint8_t *)header);
+        offset = (offset + sizeof(float) - 1) & ~(sizeof(float) - 1);
+        return (float *)((uint8_t *)header + offset);
+    }
+}
+
+#endif
diff --git a/libavutil/frame.h b/libavutil/frame.h
index d440cfb..b827793 100644
--- a/libavutil/frame.h
+++ b/libavutil/frame.h
@@ -254,6 +254,12 @@ enum AVFrameSideDataType {
